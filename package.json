{
  "name": "aura",
  "version": "0.1.0",
  "private": true,
  "description": "Aura — move your hands, shape your world. A gesture-driven generative art and sound instrument.",
  "scripts": {
    "dev": "node scripts/copy-mediapipe-wasm.mjs && next dev",
    "build": "node scripts/copy-mediapipe-wasm.mjs && next build && node scripts/generate-sw-manifest.mjs",
    "start": "node scripts/serve-static.mjs 3000",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@react-three/fiber": "9.8.1",
    "next": "16.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.182.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
