# Aura needs no secrets. Every variable here is optional and public (it is
# inlined into the client bundle), so never put credentials in this file.

# Base URL that hosts MediaPipe model files (.task). Defaults to Google's
# public model bucket. Point this at your own CDN to self-host the models;
# remember to update the connect-src directive of the Content Security Policy.
NEXT_PUBLIC_MODEL_BASE_URL=https://storage.googleapis.com/mediapipe-models
